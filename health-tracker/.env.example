# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_, never use outside trusted server code.
# Only needed for admin/background tasks; the app itself does not require it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
